import Standard

record Point {
    var x: Double
    var y: Double
}

fun move(ref p: Point, dx: Double, dy: Double): Void {
    p.x = p.x + dx
    p.y = p.y + dy
}

fun distanceSquare(p: Point): Double {
    return p.x ** 2 + p.y ** 2
}

var point: Point
point.x = 3.0
point.y = 4.0

move(&point, 1.0, 2.0)

print(point.x)
print(point.y)
print(distanceSquare(point))

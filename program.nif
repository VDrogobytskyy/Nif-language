import Standard

typealias Coordinate = Double
typealias Counter = Int
typealias Flag = Bool

let PI: Double = 3.14159
let LIMIT: Counter = 1_000
var callCounter: Counter = 0

fun greet(name: String): Void {
    print("Hello, " + name + "!")
    return
}

fun distanceSquared(x1: Coordinate, y1: Coordinate, x2: Coordinate, y2: Coordinate): Double {
    var dx: Double = x2 - x1
    var dy: Double = y2 - y1
    callCounter = callCounter + 1
    return dx ** 2.0 + dy ** 2.0
}

fun factorial(n: Counter): Int {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

fun isEven(n: Int): Flag {
    return n % 2 == 0
}

fun main(): Void {
    greet("Nif")

    // 1. Робота з числами, степенем, діленням та приведенням типів
    var ox: Coordinate = 0.0
    var oy: Coordinate = 0.0
    var tx: Coordinate = 3.0
    var ty: Coordinate = 4.0
    var distSq: Double = distanceSquared(ox, oy, tx, ty)
    var circleArea: Double = PI * (2 ** 2)
    var intDiv: Int = 7 / 2
    var negVal: Int = -intDiv + 10

    print("distSq, circleArea, 7/2, negVal:")
    print(distSq, circleArea, intDiv, negVal)

    // 2. Цикл for, рекурсія, умови, continue/break та логічні операції
    for i in 0..6 {
        if i == 0 {
            continue
        }
        var f: Int = factorial(i)
        if isEven(f) && f < LIMIT {
            print("even factorial:", i, f)
        } else if f >= LIMIT {
            break
        } else {
            print("odd factorial:", i, f)
        }
    }

    // 3. Цикл while та заперечення !
    var idx: Int = 3
    var done: Flag = false
    while !done && idx > 0 {
        idx = idx - 1
        if idx == 0 {
            done = true
        }
    }

    // 4. Введення та виведення
    var userInput: Int = 0
    print("Enter an integer:")
    read(&userInput)
    print("Input * 2 + calls:", userInput * 2, callCounter)
}
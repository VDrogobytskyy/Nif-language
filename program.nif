fun main(): Void {
    var i: Int = 0

    // Є ЦИКЛ while!
    while i < 100 {
        if i == 5 {
            // ПРАВИЛЬНО! break каже комп'ютеру:
            // "Зупини цикл while прямо зараз і більше не повторюй його!"
            break 
        }
        i = i + 1
    }

    print(i) // виведе 5
}